@{
    ViewData["Title"] = T["إتمام الطلب"];
    decimal total = ViewBag.Total ?? 0m;
    int count = ViewBag.Count ?? 0;
}

<div class="page-header">
    <div class="container">
        <h1>@T["إتمام الطلب"]</h1>
        <p>@T["أدخل بيانات التوصيل ثم أكمل الدفع عبر CliQ"]</p>
    </div>
</div>

<div class="container section">
    <div style="max-width:620px;margin:0 auto;display:flex;flex-direction:column;gap:20px">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <!-- ملخص السلة -->
        <div class="panel">
            <h2 style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sky)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                @T["ملخص السلة"]
            </h2>
            <ul class="info-list">
                <li>
                    <span class="k">@T["عدد المنتجات"]</span>
                    <span class="v">@count</span>
                </li>
                <li style="border-top:1px solid var(--border-sky);padding-top:14px;margin-top:4px">
                    <span class="k" style="font-size:.95rem;font-weight:700">@T["المبلغ الإجمالي"]</span>
                    <span class="v" style="font-size:1.5rem;font-weight:900;color:var(--sky)">
                        @T["{0} د.أ", total.ToString("N2")]
                    </span>
                </li>
            </ul>
        </div>

        <!-- بيانات التوصيل -->
        <div class="panel">
            <h2 style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-txt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                @T["بيانات التوصيل"]
            </h2>

            <form asp-action="PlaceOrder" method="post">
                @Html.AntiForgeryToken()
                <div class="form-group">
                    <label>@T["رقم الهاتف"] *</label>
                    <input type="tel" name="contactPhone" class="form-control" required
                           placeholder="07XXXXXXXX" />
                </div>
                <div class="form-group">
                    <label>@T["عنوان التوصيل"] *</label>
                    <textarea name="shippingAddress" class="form-control" rows="3" required
                              placeholder="@T["المدينة، المنطقة، الشارع، أقرب علامة مميزة"]"></textarea>
                </div>
                <div class="form-group">
                    <label>@T["ملاحظات إضافية (اختياري)"]</label>
                    <textarea name="notes" class="form-control" rows="2"></textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-block" style="padding:13px;font-size:.95rem">
                    @T["تأكيد الطلب والمتابعة للدفع"]
                </button>
            </form>
        </div>

        <div style="text-align:center">
            <a asp-controller="Cart" asp-action="Index" class="btn btn-ghost btn-sm">@T["العودة للسلة"]</a>
        </div>
    </div>
</div>