@model Order
@{
    ViewData["Title"] = $"{T["طلب"]} #{Model.OrderNumber}";
}

<div class="page-header">
    <div class="container">
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px">
            <div>
                <h1>@T["طلب"] #@Model.OrderNumber</h1>
                <p>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            @switch (Model.Status)
            {
                case OrderStatus.Pending:
                    <span class="badge-pending" style="font-size:.9rem;padding:8px 16px">@Model.Status.ToDisplay()</span>
                    break;
                case OrderStatus.UnderReview:
                    <span class="badge-pending" style="font-size:.9rem;padding:8px 16px">@Model.Status.ToDisplay()</span>
                    break;
                case OrderStatus.Paid:
                    <span class="badge-approved" style="font-size:.9rem;padding:8px 16px">@Model.Status.ToDisplay()</span>
                    break;
                case OrderStatus.Cancelled:
                    <span class="badge-rejected" style="font-size:.9rem;padding:8px 16px">@Model.Status.ToDisplay()</span>
                    break;
            }
        </div>
    </div>
</div>

<div class="container section">
    <div style="max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:20px">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <!-- المنتجات -->
        <div class="panel">
            <h2 style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--sky)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                @T["المنتجات"]
            </h2>
            <div style="display:flex;flex-direction:column;gap:10px">
                @foreach (var item in Model.Items)
                {
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
                        <div style="display:flex;align-items:center;gap:10px;min-width:0">
                            @if (!string.IsNullOrEmpty(item.ImagePath))
                            {
                                <img src="@item.ImagePath" alt="@item.ProductName" style="width:44px;height:44px;object-fit:cover;border-radius:8px" />
                            }
                            <div style="min-width:0">
                                <div style="font-weight:600;font-size:.85rem">@item.ProductName</div>
                                <div style="font-size:.75rem;color:var(--steel)">@item.Quantity × @T["{0} د.أ", item.UnitPrice.ToString("N2")]</div>
                            </div>
                        </div>
                        <span style="font-weight:700;font-size:.85rem">@T["{0} د.أ", (item.UnitPrice * item.Quantity).ToString("N2")]</span>
                    </div>
                }
                <div style="display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--border-sky);padding-top:14px">
                    <span style="font-weight:700">@T["المبلغ الإجمالي"]</span>
                    <span style="font-size:1.4rem;font-weight:900;color:var(--sky)">@T["{0} د.أ", Model.TotalAmount.ToString("N2")]</span>
                </div>
            </div>
        </div>

        <!-- بيانات التوصيل -->
        <div class="panel">
            <h2 style="display:flex;align-items:center;gap:8px;margin-bottom:16px">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--green-txt)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                @T["بيانات التوصيل"]
            </h2>
            <ul class="info-list">
                <li><span class="k">@T["الاسم"]</span><span class="v">@Model.CustomerName</span></li>
                <li><span class="k">@T["الهاتف"]</span><span class="v" dir="ltr" style="text-align:right">@Model.ContactPhone</span></li>
                <li><span class="k">@T["العنوان"]</span><span class="v">@(Model.ShippingAddress ?? "—")</span></li>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <li><span class="k">@T["ملاحظات"]</span><span class="v">@Model.Notes</span></li>
                }
                @if (!string.IsNullOrEmpty(Model.PaymentReviewNote))
                {
                    <li><span class="k">@T["ملاحظة الإدارة"]</span><span class="v">@Model.PaymentReviewNote</span></li>
                }
            </ul>
        </div>

        @if (Model.Status == OrderStatus.Pending)
        {
            <a asp-action="Payment" asp-route-id="@Model.Id" class="btn btn-primary btn-block" style="padding:13px;font-size:.95rem">
                @T["متابعة الدفع عبر CliQ"]
            </a>
        }
        else if (Model.Status == OrderStatus.UnderReview)
        {
            <div class="alert" style="background:var(--amber-bg);border-color:var(--amber-bd);color:var(--amber-txt)">
                @T["إيصال الدفع قيد المراجعة من الإدارة. سيتم تأكيد طلبك خلال 24 ساعة."]
            </div>
        }

        <div style="text-align:center">
            <a asp-action="Index" class="btn btn-ghost btn-sm">@T["كل طلباتي"]</a>
        </div>
    </div>
</div>