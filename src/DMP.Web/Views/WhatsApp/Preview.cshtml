@{
    ViewData["Title"] = T["Preview Phone Numbers"];
    var phoneNumbers = ViewBag.PhoneNumbers as List<string>;
    var phoneCount = ViewBag.PhoneCount;
    var fileName = ViewBag.FileName as string;
}

<section class="section">
    <div class="container" style="max-width:800px">
        <div class="section-head">
            <h2>@T["Preview Phone Numbers"]</h2>
            <p>@T["Review the phone numbers before creating the WhatsApp group"]</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" style="background:#ef4444;color:#fff;padding:12px 16px;border-radius:8px;margin-bottom:20px">
                @TempData["Error"]
            </div>
        }

        <div class="panel" style="padding:32px">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px">
                <div>
                    <h3 style="font-size:1.1rem;font-weight:600;color:var(--text-1)">@fileName</h3>
                    <p style="font-size:.85rem;color:var(--text-2)">@T["{0} phone numbers found", phoneCount]</p>
                </div>
                <a asp-action="Index" class="btn btn-outline btn-sm">
                    @T["Upload New File"]
                </a>
            </div>

            @if (phoneNumbers != null && phoneNumbers.Any())
            {
                <div style="max-height:300px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;margin-bottom:24px">
                    <table style="width:100%;border-collapse:collapse">
                        <thead>
                            <tr style="background:var(--bg-2);border-bottom:1px solid var(--border)">
                                <th style="padding:12px 16px;text-align:start;font-weight:600;color:var(--text-1)">#</th>
                                <th style="padding:12px 16px;text-align:start;font-weight:600;color:var(--text-1)">@T["Phone Number"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < phoneNumbers.Count; i++)
                            {
                                <tr style="border-bottom:1px solid var(--border)">
                                    <td style="padding:10px 16px;color:var(--text-2)">@(i + 1)</td>
                                    <td style="padding:10px 16px;font-family:monospace;color:var(--text-1)">@phoneNumbers[i]</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <form asp-action="CreateGroup" method="post">
                    @Html.AntiForgeryToken()

                    <div style="margin-bottom:20px">
                        <label style="display:block;font-weight:600;margin-bottom:8px;color:var(--text-1)">
                            @T["Group Name"]
                        </label>
                        <input type="text" name="groupName" required placeholder="@T["Enter WhatsApp group name"]"
                               style="width:100%;padding:12px 16px;border:1px solid var(--border);border-radius:8px;background:var(--bg-2);color:var(--text-1);font-size:.95rem"/>
                    </div>

                    <button type="submit" class="btn btn-primary" style="width:100%"
                            onclick="return confirm('@T["Are you sure you want to create a WhatsApp group with {0} participants?", phoneCount]')">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-inline-end:8px">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        @T["Create WhatsApp Group"]
                    </button>
                </form>
            }
            else
            {
                <div class="empty-state">
                    <p>@T["No phone numbers found in the file"]</p>
                    <a asp-action="Index" class="btn btn-primary">@T["Try Again"]</a>
                </div>
            }
        </div>
    </div>
</section>
