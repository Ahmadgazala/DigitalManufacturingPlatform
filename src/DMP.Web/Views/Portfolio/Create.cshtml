@model PortfolioItem
@{
    ViewData["Title"] = T["إضافة مشروع للملف الشخصي"];
}

<div class="page-header">
    <div class="container">
        <h1>@T["🗂️ إضافة مشروع"]</h1>
        <p>@T["أضف مشاريعك السابقة لتعزيز ثقة العملاء"]</p>
    </div>
</div>

<div class="container section">
    <div style="max-width:620px;margin:0 auto">
        <div class="panel">
            <form asp-controller="Portfolio" asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="Title">@T["عنوان المشروع"]</label>
                    <input asp-for="Title" class="form-control" placeholder="@T["مثال: قطع ليزر لواجهة محل تجاري"]" />
                    <span asp-validation-for="Title" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Category">@T["التخصص"]</label>
                    <select asp-for="Category" class="form-control">
                        <option value="">@T["— اختر التخصص —"]</option>
                        @foreach (MachineCategory cat in ViewBag.Categories)
                        {
                            <option value="@((int)cat)">@cat.ToArabic()</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Description">@T["وصف المشروع"]</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="@T["صف المواد المستخدمة، التحديات، والنتيجة..."]"></textarea>
                </div>

                <div class="form-group">
                    <label asp-for="CompletedAt">@T["تاريخ الإنجاز"]</label>
                    <input asp-for="CompletedAt" class="form-control" type="date"
                           value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <label>@T["صورة المشروع"]</label>
                    <div class="upload-zone" id="uploadZone" onclick="document.getElementById('imgInput').click()">
                        <span class="uz-icon">🖼️</span>
                        <span class="uz-text">@T["انقر لرفع صورة"]</span>
                        <span class="uz-hint">JPG, PNG — @T["حتى 5MB"]</span>
                        <span class="uz-selected" id="fileName"></span>
                    </div>
                    <input type="file" id="imgInput" name="image" accept="image/*" style="display:none"
                           onchange="document.getElementById('fileName').textContent = this.files[0]?.name ?? ''" />
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">@T["✅ إضافة المشروع"]</button>
                    <a asp-controller="Manufacturers" asp-action="Dashboard" class="btn btn-ghost">@T["إلغاء"]</a>
                </div>
            </form>
        </div>
    </div>
</div>
