@model Supplier
@{
    ViewData["Title"] = Model.Name;
}

<div class="page-header">
    <div class="container">
        <h1>@Model.Name</h1>
    </div>
</div>

<div class="container section">
    <div class="detail-grid">
        <div>
            <div class="panel">
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <h2>عن المورد</h2>
                    <p style="color:var(--ink-mid);line-height:1.8">@Model.Description</p>
                }

                @if (!string.IsNullOrEmpty(Model.Materials))
                {
                    <div style="margin-top:16px">
                        <h3 style="font-size:.9rem;margin-bottom:8px">المواد المتوفرة</h3>
                        <span class="chip chip-green">@Model.Materials</span>
                    </div>
                }
            </div>
        </div>

        <aside>
            <div class="panel">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <div style="text-align:center;margin-bottom:16px">
                        <img src="@Model.LogoPath" style="max-height:80px;max-width:180px;object-fit:contain" />
                    </div>
                }
                <ul class="info-list">
                    @if (!string.IsNullOrEmpty(Model.City))
                    {
                        <li><span class="k">المدينة</span><span class="v">@Model.City</span></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <li><span class="k">العنوان</span><span class="v">@Model.Address</span></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <li><span class="k">الهاتف</span><span class="v" dir="ltr"><a href="tel:@Model.Phone">@Model.Phone</a></span></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <li><span class="k">البريد</span><span class="v" dir="ltr"><a href="mailto:@Model.Email">@Model.Email</a></span></li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <li><span class="k">الموقع</span><span class="v"><a href="@Model.Website" target="_blank" style="color:var(--sky)">زيارة الموقع ↗</a></span></li>
                    }
                </ul>
            </div>
            <a class="btn btn-outline btn-block" asp-controller="Suppliers" asp-action="Index">← كل الموردين</a>
        </aside>
    </div>
</div>
