@model Supplier
@{
    ViewData["Title"] = "إضافة مورد جديد";
}

<div class="page-header">
    <div class="container">
        <h1>➕ إضافة مورد جديد</h1>
        <p>أضف مورداً للمواد الخام أو المعدات إلى الدليل</p>
    </div>
</div>

<div class="container section">
    <div style="max-width:720px;margin:0 auto">
        <div class="panel">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="form-row">
                    <div class="form-group">
                        <label>اسم المورد <span style="color:var(--red)">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="مثال: شركة المواد الصناعية" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label>المدينة</label>
                        <input asp-for="City" class="form-control" placeholder="عمّان، إربد، الزرقاء..." />
                    </div>
                </div>

                <div class="form-group">
                    <label>وصف المورد</label>
                    <textarea asp-for="Description" class="form-control" rows="4"
                              placeholder="اكتب وصفاً للمورد وما يقدمه..."></textarea>
                </div>

                <div class="form-group">
                    <label>المواد والمنتجات المتوفرة</label>
                    <input asp-for="Materials" class="form-control"
                           placeholder="مثال: ألمنيوم، بلاستيك، فولاذ، خشب..." />
                    <small style="color:var(--steel)">افصل بين المواد بفاصلة</small>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>رقم الهاتف</label>
                        <input asp-for="Phone" class="form-control" dir="ltr" placeholder="07X-XXX-XXXX" />
                    </div>
                    <div class="form-group">
                        <label>البريد الإلكتروني</label>
                        <input asp-for="Email" class="form-control" dir="ltr" type="email" placeholder="info@supplier.jo" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>الموقع الإلكتروني</label>
                        <input asp-for="Website" class="form-control" dir="ltr" placeholder="https://www.supplier.jo" />
                    </div>
                    <div class="form-group">
                        <label>العنوان التفصيلي</label>
                        <input asp-for="Address" class="form-control" placeholder="الشارع، المنطقة..." />
                    </div>
                </div>

                <div class="form-group">
                    <label>شعار المورد (Logo)</label>
                    <input type="file" name="logo" accept="image/*" class="form-control" />
                    <small style="color:var(--steel)">JPG، PNG، WebP — حجم أقصى 5MB</small>
                </div>

                <div style="display:flex;gap:12px;margin-top:6px">
                    <button type="submit" class="btn btn-primary">💾 حفظ المورد</button>
                    <a asp-action="Index" class="btn btn-outline">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
