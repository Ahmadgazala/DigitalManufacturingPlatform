@model Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="container section">
    <div style="margin-bottom:16px">
        <a asp-action="Index" class="btn btn-outline btn-sm">@T["← العودة للسوق"]</a>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start">
        <div>
            @if (!string.IsNullOrEmpty(Model.CoverImage))
            {
                <div style="border-radius:var(--r-md);overflow:hidden;max-height:400px">
                    <img id="mainProductImage" src="@Model.CoverImage" alt="@Model.Name" style="width:100%;height:100%;object-fit:cover" />
                </div>
                @if (Model.Images.Count > 1)
                {
                    <div style="display:flex;gap:8px;margin-top:10px;flex-wrap:wrap">
                        @foreach (var img in Model.Images.OrderByDescending(i => i.IsCover))
                        {
                            <img src="@img.ImagePath" class="gallery-thumb thumb-select @(img == Model.Images.OrderByDescending(i => i.IsCover).First() ? "is-cover" : "")"
                                 data-src="@img.ImagePath" alt="@Model.Name"
                                 style="width:70px;height:70px;object-fit:cover;border-radius:8px;cursor:pointer" onmouseover="this.style.opacity=.7" onmouseout="this.style.opacity=1" />
                        }
                    </div>
                }
            }
            else
            {
                <div style="background:var(--paper);border-radius:var(--r-md);height:300px;display:flex;align-items:center;justify-content:center;font-size:5rem">📦</div>
            }
        </div>

        <div>
            <div style="display:flex;gap:8px;margin-bottom:12px">
                <span style="font-size:.8rem;padding:4px 12px;border-radius:100px;background:var(--paper);color:var(--steel)">@Model.Category.ToDisplay()</span>
                @if (Model.SellerType == SellerType.Admin)
                {
                    <span style="font-size:.8rem;padding:4px 12px;border-radius:100px;background:var(--primary);color:#fff">@T["إدارة Jo Maker"]</span>
                }
                else
                {
                    <span style="font-size:.8rem;padding:4px 12px;border-radius:100px;background:var(--amber);color:#000">@T["مصنّع"]</span>
                }
            </div>

            <h1 style="font-size:1.6rem;font-weight:800;margin-bottom:8px">@Model.Name</h1>

            <div style="font-size:1.5rem;font-weight:800;color:var(--primary);margin-bottom:16px">
                @T["{0} د.أ", Model.Price.ToString("N2")]
            </div>

            @if (Model.ReviewsCount > 0)
            {
                <div class="star-rating" style="margin-bottom:16px;font-size:1rem">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= (int)Math.Round(Model.AverageRating) ? "star filled" : "star")">&#9733;</span>
                    }
                    <span style="color:var(--steel)">@Model.AverageRating.ToString("0.0") — @T["{0} تقييم", Model.ReviewsCount]</span>
                </div>
            }

            <div style="display:flex;gap:16px;margin-bottom:20px;font-size:.9rem">
                <div>
                    <span style="color:var(--steel)">@T["المتوفر"]: </span>
                    <strong>@Model.Stock</strong>
                </div>
                <div>
                    <span style="color:var(--steel)">@T["التاريخ"]: </span>
                    <span>@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </div>

            @if (Model.Stock <= 0 || !Model.IsActive)
            {
                <div class="alert alert-error" style="max-width:360px">
                    @T["هذا المنتج غير متوفر حالياً."]
                </div>
            }
            else
            {
                <form asp-controller="Cart" asp-action="Add" method="post" style="max-width:360px;margin-bottom:24px">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div style="display:flex;gap:10px;align-items:stretch">
                        <div style="width:110px">
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="form-control" style="height:100%" />
                        </div>
                        <button type="submit" class="btn btn-primary" style="flex:1;padding:12px">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align:-3px"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                            @T["أضف إلى السلة"]
                        </button>
                    </div>
                    <p style="font-size:.8rem;color:var(--steel);margin-top:6px">@T["{0} قطعة متوفرة", Model.Stock]</p>
                </form>
            }

            @if (Model.Description != null)
            {
                <div style="margin-bottom:24px">
                    <h3 style="font-size:1rem;font-weight:700;margin-bottom:8px">@T["الوصف"]</h3>
                    <p style="color:var(--steel);line-height:1.7;white-space:pre-wrap">@Model.Description</p>
                </div>
            }

            <div class="panel" style="background:var(--paper)">
                <h3 style="font-size:.95rem;font-weight:700;margin-bottom:12px">@T["معلومات البائع"]</h3>
                @if (Model.SellerType == SellerType.Admin)
                {
                    <p style="font-size:.9rem;color:var(--steel)">
                        @T["المنتج مقدم من إدارة Jo Maker. للتواصل:"]
                    </p>
                    <p style="font-size:.9rem"><strong>@T["البريد"]: </strong>admin@dmp.jo</p>
                }
                else if (Model.Manufacturer != null)
                {
                    <p style="font-size:.9rem;margin-bottom:8px">
                        <strong>@Model.Manufacturer.WorkshopName</strong>
                    </p>
                    @if (Model.Manufacturer.City != null)
                    {
                        <p style="font-size:.85rem;color:var(--steel)">📍 @Model.Manufacturer.City</p>
                    }
                    @if (Model.Manufacturer.ContactPhone != null)
                    {
                        <p style="font-size:.85rem;color:var(--steel)">📞 @Model.Manufacturer.ContactPhone</p>
                    }
                    @if (Model.Manufacturer.ContactEmail != null)
                    {
                        <p style="font-size:.85rem;color:var(--steel)">✉️ @Model.Manufacturer.ContactEmail</p>
                    }
                    <a asp-controller="Manufacturers" asp-action="Details" asp-route-id="@Model.ManufacturerId"
                       class="btn btn-outline btn-sm" style="margin-top:8px">@T["عرض الورشة"]</a>
                }
            </div>
        </div>
    </div>

    <div class="panel" style="margin-top:32px">
            <h2 style="font-size:1.1rem;font-weight:800;margin-bottom:16px">@T["تقييمات المنتج"]</h2>

            @if (Model.Reviews.Count > 0)
            {
                @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                {
                    <div class="review-item">
                        <div class="review-header">
                            <strong>@review.CustomerName</strong>
                            <div class="star-rating">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= review.Rating ? "star filled" : "star")">&#9733;</span>
                                }
                            </div>
                            <span class="review-date">@review.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(review.Comment))
                        {
                            <p>@review.Comment</p>
                        }
                    </div>
                }
            }
            else
            {
                <p style="color:var(--steel)">@T["لا توجد تقييمات بعد. كن أول من يقيّم هذا المنتج!"]</p>
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div style="margin-top:20px;border-top:1px solid var(--line);padding-top:20px">
                    <h3 style="font-size:.95rem;font-weight:700;margin-bottom:12px">@T["AddReview"]</h3>
                    <form asp-controller="Products" asp-action="AddReview" asp-route-id="@Model.Id" method="post" style="max-width:520px">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label>@T["Rating"]</label>
                            <div class="star-rating-input" id="starInput">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star-btn" data-value="@i">&#9733;</span>
                                }
                            </div>
                            <input type="hidden" name="Rating" id="ratingValue" value="0" />
                        </div>
                        <div class="form-group">
                            <label for="Comment">@T["Comment"]</label>
                            <textarea name="Comment" id="Comment" class="form-control" rows="3" placeholder="@T["WriteYourReview"]"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">@T["SubmitReview"]</button>
                    </form>
                </div>
            }
            else
            {
                <p style="font-size:.9rem;color:var(--steel);margin-top:16px">
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Products/Details/@Model.Id">@T["سجّل الدخول لتقييم هذا المنتج"]</a>
                </p>
            }
    </div>
</div>

@section Scripts {
    <script>
        var thumbSelects = document.querySelectorAll('.thumb-select');
        thumbSelects.forEach(function (t) {
            t.addEventListener('click', function () {
                var main = document.getElementById('mainProductImage');
                if (main) main.src = t.getAttribute('data-src');
                thumbSelects.forEach(function (x) { x.classList.remove('is-cover'); });
                t.classList.add('is-cover');
            });
        });
        var stars = document.querySelectorAll('#starInput .star-btn');
        var input = document.getElementById('ratingValue');
        stars.forEach(function (star) {
            star.addEventListener('click', function () {
                var val = parseInt(star.getAttribute('data-value'));
                input.value = val;
                stars.forEach(function (s, idx) {
                    s.classList.toggle('filled', idx < val);
                });
            });
        });
    </script>
}
