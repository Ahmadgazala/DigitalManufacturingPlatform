@model Product
@{
    ViewData["Title"] = T["تعديل المنتج"];
}

<div class="container">
    <div class="page-header">
        <h1>@T["تعديل المنتج"]</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="panel">
        <form asp-action="EditProduct" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Name">@T["اسم المنتج"]</label>
                <input type="text" name="Name" id="Name" class="form-control" value="@Model.Name" required maxlength="200" />
            </div>

            <div class="form-group">
                <label for="Description">@T["الوصف"]</label>
                <textarea name="Description" id="Description" class="form-control" rows="4" maxlength="2000">@Model.Description</textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="Price">@T["السعر (د.أ)"]</label>
                    <input type="number" name="Price" id="Price" class="form-control" step="0.01" min="0.01" value="@Model.Price" required />
                </div>
                <div class="form-group">
                    <label for="Stock">@T["المخزون"]</label>
                    <input type="number" name="Stock" id="Stock" class="form-control" min="0" value="@Model.Stock" />
                </div>
            </div>

            <div class="form-group">
                <label for="Category">@T["الفئة"]</label>
                <select name="Category" id="Category" class="form-control">
                    @foreach (ProductCategory cat in Enum.GetValues<ProductCategory>())
                    {
                        <option value="@cat" selected="@(Model.Category == cat)">@cat.ToDisplay()</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                    <input type="checkbox" name="IsActive" value="true" checked="@(Model.IsActive)" />
                    @T["نشط (ظاهر في السوق)"]
                </label>
            </div>

            <div class="form-group">
                <label>@T["صور المنتج"]</label>

                @if (Model.Images.Any())
                {
                    <div class="product-gallery mgr-gallery" style="display:flex;flex-wrap:wrap;gap:10px;margin-bottom:12px">
                        @foreach (var img in Model.Images)
                        {
                            <div class="mgr-thumb @(img.IsCover ? "is-cover" : "")" style="position:relative;width:90px">
                                <img src="@img.ImagePath" style="width:90px;height:90px;border-radius:8px;object-fit:cover" />
                                @if (img.IsCover)
                                {
                                    <span style="position:absolute;top:4px;left:4px;right:4px;background:rgba(0,0,0,.7);color:#fff;font-size:.65rem;padding:2px 6px;border-radius:6px;text-align:center">@T["الغلاف"]</span>
                                }
                                <label style="display:flex;align-items:center;gap:4px;font-size:.7rem;margin-top:4px;cursor:pointer">
                                    <input type="radio" name="coverImageId" value="@img.Id" checked="@(img.IsCover)" /> @T["غلاف"]
                                </label>
                                <label style="display:flex;align-items:center;gap:4px;font-size:.7rem;cursor:pointer;color:var(--red-txt)">
                                    <input type="checkbox" name="removeImageIds" value="@img.Id" /> @T["حذف"]
                                </label>
                            </div>
                        }
                    </div>
                }
                else if (!string.IsNullOrEmpty(Model.ImagePath))
                {
                    <div style="margin-bottom:8px">
                        <img src="@Model.ImagePath" style="width:100px;height:100px;border-radius:8px;object-fit:cover" />
                        <span style="font-size:.8rem;color:var(--steel);margin-inline-start:8px">@T["الصورة الحالية"]</span>
                    </div>
                }

                <div class="upload-zone">
                    <input type="file" name="imageFiles" id="imageFiles" accept="image/*" multiple class="upload-input" />
                    <span>@T["أضف صوراً إضافية"]</span>
                </div>
                <div id="newPreviews" class="product-gallery" style="margin-top:8px"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["حفظ التعديلات"]</button>
                <a asp-action="MyProducts" class="btn btn-outline">@T["إلغاء"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageFiles').addEventListener('change', function () {
            var gallery = document.getElementById('newPreviews');
            gallery.innerHTML = '';
            if (this.files) {
                for (var i = 0; i < this.files.length; i++) {
                    (function (file) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            var img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'gallery-thumb';
                            gallery.appendChild(img);
                        };
                        reader.readAsDataURL(file);
                    })(this.files[i]);
                }
            }
        });
    </script>
}
