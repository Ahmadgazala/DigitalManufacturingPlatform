@{
    ViewData["Title"] = T["AdminDashboard"];
    int totalManufacturers = ViewBag.TotalManufacturers ?? 0;
    int pendingManufacturers = ViewBag.PendingManufacturers ?? 0;
    int totalUsers = ViewBag.TotalUsers ?? 0;
    int totalRequests = ViewBag.TotalRequests ?? 0;
    int pendingRequests = ViewBag.PendingRequests ?? 0;
    int totalCampaigns = ViewBag.TotalCampaigns ?? 0;
    int totalSuppliers = ViewBag.TotalSuppliers ?? 0;
}

<div class="container">
    <div class="dash-header">
        <h1>@T["AdminDashboard"]</h1>
    </div>

    <div class="kpi-row">
        <div class="kpi-card">
            <span class="kpi-label">@T["TotalManufacturers"]</span>
            <span class="kpi-value">@totalManufacturers</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">@T["PendingApproval"]</span>
            <span class="kpi-value @(pendingManufacturers > 0 ? "kpi-warning" : "")">@pendingManufacturers</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">@T["TotalUsers"]</span>
            <span class="kpi-value">@totalUsers</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">@T["TotalRequests"]</span>
            <span class="kpi-value">@totalRequests</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">@T["PendingRequests"]</span>
            <span class="kpi-value @(pendingRequests > 0 ? "kpi-warning" : "")">@pendingRequests</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">@T["ActiveCampaigns"]</span>
            <span class="kpi-value">@totalCampaigns</span>
        </div>
        <div class="kpi-card">
            <span class="kpi-label">@T["TotalSuppliers"]</span>
            <span class="kpi-value">@totalSuppliers</span>
        </div>
    </div>

    <div class="dash-grid">
        <div class="dash-card">
            <div class="dash-body">
                <h3>@T["ManufacturersManagement"]</h3>
                <p>@T["PendingApproval"]: <strong>@pendingManufacturers</strong></p>
                <a asp-controller="Admin" asp-action="Manufacturers" class="btn btn-primary">@T["ManageManufacturers"]</a>
            </div>
        </div>
        <div class="dash-card">
            <div class="dash-body">
                <h3>@T["UsersManagement"]</h3>
                <p>@T["TotalUsers"]: <strong>@totalUsers</strong></p>
                <a asp-controller="Admin" asp-action="Users" class="btn btn-primary">@T["ManageUsers"]</a>
            </div>
        </div>
        <div class="dash-card">
            <div class="dash-body">
                <h3>@T["GroupBuying"]</h3>
                <a asp-controller="Admin" asp-action="GroupBuying" class="btn btn-outline">@T["إدارة الحملات"]</a>
                <a asp-controller="GroupBuying" asp-action="Create" class="btn btn-primary">@T["CreateCampaign"]</a>
            </div>
        </div>
        <div class="dash-card">
            <div class="dash-body">
                <h3>@T["Suppliers"]</h3>
                <a asp-controller="Suppliers" asp-action="Index" class="btn btn-outline">@T["ViewSuppliers"]</a>
            </div>
        </div>
        <div class="dash-card" style="border-color:var(--border-sky)">
            <div class="dash-body">
                <h3 style="display:flex;align-items:center;gap:8px">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--sky)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                    @T["مراجعة المدفوعات"]
                </h3>
                <p>@T["إيصالات CliQ بانتظار الموافقة"]</p>
                <a asp-controller="Admin" asp-action="Payments" class="btn btn-primary">@T["مراجعة الإيصالات"]</a>
            </div>
        </div>
        <div class="dash-card">
            <div class="dash-body">
                <h3>@T["إدارة الطلبات"]</h3>
                <p>@T["TotalRequests"]: <strong>@totalRequests</strong></p>
                <p>@T["PendingRequests"]: <strong style="color:var(--amber)">@pendingRequests</strong></p>
                <a asp-controller="Admin" asp-action="Requests" class="btn btn-outline">@T["عرض الطلبات"]</a>
                @if (pendingRequests > 0)
                {
                    <a asp-controller="Admin" asp-action="Requests" asp-route-approval="pending" class="btn btn-primary">@T["اعتماد الطلبات"]</a>
                }
            </div>
        </div>
    </div>
</div>
