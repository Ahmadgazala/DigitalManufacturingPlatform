@model List<ManufacturingRequest>
@{
    ViewData["Title"] = "إدارة الطلبات";
    string? statusFilter = ViewBag.StatusFilter;
    string? search       = ViewBag.Search;
}

<div class="page-header">
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
            <h1>إدارة الطلبات</h1>
            <p style="margin:0;color:var(--steel)">@Model.Count طلب</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline btn-sm">← لوحة التحكم</a>
    </div>
</div>

<div class="container section">

    @* فلترة وبحث *@
    <form method="get" action="/Admin/Requests" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px">
        <input name="search" value="@search" class="input" placeholder="ابحث باسم الطلب أو العميل…" style="flex:1;min-width:200px" />
        <select name="status" class="input" style="width:180px">
            <option value="">كل الحالات</option>
            @foreach (var s in Enum.GetValues<RequestStatus>())
            {
                <option value="@s" selected="@(statusFilter == s.ToString())">@s.ToArabic()</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">بحث</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(statusFilter))
        {
            <a href="/Admin/Requests" class="btn btn-ghost">مسح</a>
        }
    </form>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <h3>لا توجد طلبات</h3>
            <p>لم يتم إيجاد طلبات تطابق الفلتر المحدد.</p>
        </div>
    }
    else
    {
        <div class="panel" style="padding:0;overflow:hidden">
            <table style="width:100%;border-collapse:collapse">
                <thead>
                    <tr style="background:var(--paper);border-bottom:2px solid var(--line)">
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">#</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">الطلب</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">العميل</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">المصنّع</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">الحالة</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">الدفع</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">العروض</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">التاريخ</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in Model)
                    {
                        <tr style="border-bottom:1px solid var(--line)">
                            <td style="padding:12px 16px;color:var(--steel);font-size:.85rem">#@req.Id</td>
                            <td style="padding:12px 16px">
                                <span style="font-weight:600">@req.Title</span>
                                <div style="font-size:.8rem;color:var(--steel)">@req.Category.ToArabic()</div>
                            </td>
                            <td style="padding:12px 16px;font-size:.88rem">@(req.Customer?.FullName ?? "—")</td>
                            <td style="padding:12px 16px;font-size:.88rem">@(req.Manufacturer?.WorkshopName ?? "—")</td>
                            <td style="padding:12px 16px">
                                <span class="chip @(req.Status == RequestStatus.Open ? "chip-blue" : req.Status == RequestStatus.InProgress ? "chip-amber" : req.Status == RequestStatus.Completed ? "chip-green" : "chip-red")">
                                    @req.Status.ToArabic()
                                </span>
                            </td>
                            <td style="padding:12px 16px">
                                @{
                                    var payClass = req.PaymentStatus switch {
                                        PaymentStatus.Paid        => "chip-green",
                                        PaymentStatus.UnderReview => "chip-amber",
                                        PaymentStatus.NotPaid     => "chip-red",
                                        _                         => "chip-blue"
                                    };
                                    var payLabel = req.PaymentStatus switch {
                                        PaymentStatus.Paid        => "مدفوع",
                                        PaymentStatus.UnderReview => "قيد المراجعة",
                                        PaymentStatus.NotPaid     => "غير مدفوع",
                                        PaymentStatus.Pending     => "معلّق",
                                        PaymentStatus.Refunded    => "مُسترد",
                                        _                         => req.PaymentStatus.ToString()
                                    };
                                }
                                <span class="chip @payClass">@payLabel</span>
                            </td>
                            <td style="padding:12px 16px;text-align:center">@req.Quotations.Count</td>
                            <td style="padding:12px 16px;font-size:.8rem;color:var(--steel)">
                                @req.CreatedAt.ToString("dd/MM/yyyy")
                            </td>
                            <td style="padding:12px 16px">
                                <a asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id"
                                   class="btn btn-ghost btn-sm">عرض</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
