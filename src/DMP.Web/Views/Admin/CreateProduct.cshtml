@{
    ViewData["Title"] = T["إضافة منتج جديد"];
}

<div class="container">
    <div class="page-header">
        <h1>@T["إضافة منتج جديد"]</h1>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-error">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="panel">
        <form asp-action="CreateProduct" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Name">@T["اسم المنتج"]</label>
                <input type="text" name="Name" id="Name" class="form-control" required maxlength="200" />
            </div>

            <div class="form-group">
                <label for="Description">@T["الوصف"]</label>
                <textarea name="Description" id="Description" class="form-control" rows="4" maxlength="2000"></textarea>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label for="Price">@T["السعر (د.أ)"]</label>
                    <input type="number" name="Price" id="Price" class="form-control" step="0.01" min="0.01" required />
                </div>
                <div class="form-group">
                    <label for="Stock">@T["المخزون"]</label>
                    <input type="number" name="Stock" id="Stock" class="form-control" min="0" value="0" />
                </div>
            </div>

            <div class="form-group">
                <label for="Category">@T["الفئة"]</label>
                <select name="Category" id="Category" class="form-control">
                    @foreach (ProductCategory cat in Enum.GetValues<ProductCategory>())
                    {
                        <option value="@cat">@cat.ToDisplay()</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>@T["صور المنتج"]</label>
                <div class="upload-zone">
                    <input type="file" name="imageFiles" id="imageFiles" accept="image/*" multiple class="upload-input" />
                    <span>@T["اختر صورة واحدة أو أكثر — أول صورة ستكون الغلاف"]</span>
                </div>
                <div id="imgPreview" class="product-gallery"></div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["إضافة المنتج"]</button>
                <a asp-action="Products" class="btn btn-outline">@T["إلغاء"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('imageFiles').addEventListener('change', function () {
            var gallery = document.getElementById('imgPreview');
            gallery.innerHTML = '';
            if (this.files) {
                for (var i = 0; i < this.files.length; i++) {
                    (function (file) {
                        var reader = new FileReader();
                        reader.onload = function (e) {
                            var img = document.createElement('img');
                            img.src = e.target.result;
                            img.className = 'gallery-thumb';
                            if (gallery.children.length === 0) {
                                img.classList.add('is-cover');
                                img.title = '@T["صورة الغلاف"]';
                            }
                            gallery.appendChild(img);
                        };
                        reader.readAsDataURL(file);
                    })(this.files[i]);
                }
            }
        });
    </script>
}
