@model List<ApplicationUser>
@{
    ViewData["Title"] = T["إدارة المستخدمين"];
    var usersWithRoles = ViewBag.UsersWithRoles as List<(ApplicationUser User, IList<string> Roles)>
                         ?? new();
}

<div class="page-header">
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
            <h1>@T["إدارة المستخدمين"]</h1>
            <p style="margin:0;color:var(--steel)">@T["{0} مستخدم مسجّل", Model.Count]</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline btn-sm">@T["← لوحة التحكم"]</a>
    </div>
</div>

<div class="container section">
    @if (Model.Any())
    {
        <div class="panel" style="padding:0;overflow:hidden">
            <div class="table-wrap">
            <table style="width:100%;border-collapse:collapse">
                <thead>
                    <tr style="background:var(--paper);border-bottom:2px solid var(--line)">
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">@T["الاسم"]</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">@T["البريد الإلكتروني"]</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">@T["الدور"]</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">@T["تاريخ التسجيل"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        var roles = usersWithRoles.FirstOrDefault(x => x.User.Id == user.Id).Roles
                                    ?? new List<string>();
                        <tr style="border-bottom:1px solid var(--paper)">
                            <td style="padding:12px 16px;font-weight:600">@user.FullName</td>
                            <td style="padding:12px 16px;font-size:.88rem;color:var(--steel)" dir="ltr">@user.Email</td>
                            <td style="padding:12px 16px">
                                @foreach (var role in roles)
                                {
                                    var chipClass = role == "Admin" ? "chip-red" : role == "Manufacturer" ? "chip-blue" : "chip-green";
                                    var roleAr    = role == "Admin" ? T["أدمن"] : role == "Manufacturer" ? T["مصنّع"] : T["عميل"];
                                    <span class="chip @chipClass" style="font-size:.75rem">@roleAr</span>
                                }
                            </td>
                            <td style="padding:12px 16px;font-size:.85rem;color:var(--steel)">@user.CreatedAt.ToString("yyyy/MM/dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="ico">👥</div>
            <h3>@T["لا يوجد مستخدمون"]</h3>
        </div>
    }
</div>
