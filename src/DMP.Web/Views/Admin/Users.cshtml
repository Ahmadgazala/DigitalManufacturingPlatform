@model List<ApplicationUser>
@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<div class="page-header">
    <div class="container" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
        <div>
            <h1>إدارة المستخدمين</h1>
            <p style="margin:0;color:var(--steel)">@Model.Count مستخدم مسجّل</p>
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline btn-sm">← لوحة التحكم</a>
    </div>
</div>

<div class="container section">
    @if (Model.Any())
    {
        <div class="panel" style="padding:0;overflow:hidden">
            <table style="width:100%;border-collapse:collapse">
                <thead>
                    <tr style="background:var(--paper);border-bottom:2px solid var(--line)">
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">الاسم</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">البريد الإلكتروني</th>
                        <th style="padding:12px 16px;text-align:start;font-size:.85rem;color:var(--steel)">تاريخ التسجيل</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr style="border-bottom:1px solid var(--paper)">
                            <td style="padding:12px 16px;font-weight:600">@user.FullName</td>
                            <td style="padding:12px 16px;font-size:.88rem;color:var(--steel)" dir="ltr">@user.Email</td>
                            <td style="padding:12px 16px;font-size:.85rem;color:var(--steel)">@user.CreatedAt.ToString("yyyy/MM/dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="ico">👥</div>
            <h3>لا يوجد مستخدمون</h3>
        </div>
    }
</div>
