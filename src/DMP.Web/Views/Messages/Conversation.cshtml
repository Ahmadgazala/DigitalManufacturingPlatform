@model List<Message>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = T["Conversation"];
    var otherUserId = ViewBag.OtherUserId as string;
    var otherUser   = ViewBag.OtherUser as ApplicationUser;
    var otherUserName = otherUser?.FullName ?? T["User"].Value;
    var currentUserId = UserManager.GetUserId(User);
    var lastTime = Model.Any() ? Model.Max(m => m.SentAt).ToString("o") : DateTime.UtcNow.ToString("o");
}

<div class="container">
    <div class="page-header">
        <h1>@T["ConversationWith"] @otherUserName</h1>
        <a asp-controller="Messages" asp-action="Inbox" class="btn btn-outline btn-sm">@T["BackToInbox"]</a>
    </div>

    <div class="chat-box" id="chatBox">
        @if (Model != null && Model.Any())
        {
            @foreach (var msg in Model.OrderBy(m => m.SentAt))
            {
                bool isMine = msg.SenderId == currentUserId;
                <div class="chat-msg @(isMine ? "chat-msg-mine" : "chat-msg-other")">
                    <div class="chat-bubble">
                        <p>@msg.Body</p>
                        <span class="chat-time">@msg.SentAt.ToString("dd/MM HH:mm")</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>@T["NoMessagesYet"]</p>
            </div>
        }
    </div>

    <div class="chat-compose panel">
        <form asp-controller="Messages" asp-action="Send" method="post" id="sendForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="receiverId" value="@otherUserId" />
            <div class="form-row">
                <div class="form-group" style="flex:1;">
                    <input type="text" name="body" id="messageContent" class="form-control" placeholder="@T["TypeMessage"]" required autocomplete="off" maxlength="2000" />
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary" id="sendBtn">@T["Send"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var chatBox      = document.getElementById('chatBox');
            var sendForm     = document.getElementById('sendForm');
            var msgInput     = document.getElementById('messageContent');
            var sendBtn      = document.getElementById('sendBtn');
            var otherUserId  = '@otherUserId';
            var myId         = '@currentUserId';
            var lastTime     = '@lastTime';
            var tokenInput   = sendForm.querySelector('input[name="__RequestVerificationToken"]');
            var csrfToken    = tokenInput ? tokenInput.value : '';

            function scrollToBottom() {
                if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
            }

            function buildMsgHtml(body, senderId, sentAt) {
                var isMine = senderId === myId;
                var d = new Date(sentAt);
                var dd = String(d.getDate()).padStart(2, '0');
                var mm = String(d.getMonth() + 1).padStart(2, '0');
                var hh = String(d.getHours()).padStart(2, '0');
                var mi = String(d.getMinutes()).padStart(2, '0');
                var displayTime = dd + '/' + mm + ' ' + hh + ':' + mi;
                var div = document.createElement('div');
                div.className = 'chat-msg ' + (isMine ? 'chat-msg-mine' : 'chat-msg-other');
                div.innerHTML =
                    '<div class="chat-bubble">' +
                    '<p>' + escHtml(body) + '</p>' +
                    '<span class="chat-time">' + displayTime + '</span>' +
                    '</div>';
                return div;
            }

            function escHtml(s) {
                var d = document.createElement('div');
                d.textContent = s;
                return d.innerHTML;
            }

            // ——— Send via AJAX ———
            sendForm.addEventListener('submit', function (e) {
                e.preventDefault();
                var body = msgInput.value.trim();
                if (!body) return;

                sendBtn.disabled = true;
                var fd = new FormData();
                fd.append('receiverId', otherUserId);
                fd.append('body', body);
                fd.append('__RequestVerificationToken', csrfToken);

                fetch('/Messages/Send', {
                    method: 'POST',
                    body: fd
                }).then(function (r) {
                    if (r.ok) {
                        msgInput.value = '';
                        // Immediately fetch latest messages
                        pollMessages();
                    }
                }).finally(function () {
                    sendBtn.disabled = false;
                    msgInput.focus();
                });
            });

            // ——— Poll for new messages ———
            function pollMessages() {
                fetch('/Messages/NewMessages?otherUserId=' + encodeURIComponent(otherUserId) + '&after=' + encodeURIComponent(lastTime))
                    .then(function (r) { return r.json(); })
                    .then(function (msgs) {
                        if (!msgs || !msgs.length) return;
                        // Remove empty-state if present
                        var empty = chatBox.querySelector('.empty-state');
                        if (empty) empty.remove();

                        msgs.forEach(function (m) {
                            chatBox.appendChild(buildMsgHtml(m.body, m.senderId, m.sentAt));
                            lastTime = m.sentAt; // update cursor
                        });
                        scrollToBottom();
                    });
            }

            scrollToBottom();
            setInterval(pollMessages, 3000);
        })();
    </script>
}
