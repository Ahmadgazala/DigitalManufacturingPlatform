@model List<Message>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = T["Conversation"];
    var otherUserId = ViewBag.OtherUserId as string;
    var otherUser   = ViewBag.OtherUser as ApplicationUser;
    var otherUserName = otherUser?.FullName ?? T["User"].Value;
    var currentUserId = UserManager.GetUserId(User);
}

<div class="container">
    <div class="page-header">
        <h1>@T["ConversationWith"] @otherUserName</h1>
        <a asp-controller="Messages" asp-action="Inbox" class="btn btn-outline btn-sm">@T["BackToInbox"]</a>
    </div>

    <div class="chat-box" id="chatBox">
        @if (Model != null && Model.Any())
        {
            @foreach (var msg in Model.OrderBy(m => m.SentAt))
            {
                bool isMine = msg.SenderId == currentUserId;
                <div class="chat-msg @(isMine ? "chat-msg-mine" : "chat-msg-other")">
                    <div class="chat-bubble">
                        <p>@msg.Body</p>
                        <span class="chat-time">@msg.SentAt.ToString("dd/MM HH:mm")</span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <p>@T["NoMessagesYet"]</p>
            </div>
        }
    </div>

    <div class="chat-compose panel">
        <form asp-controller="Messages" asp-action="Send" method="post" id="sendForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="receiverId" value="@otherUserId" />
            <div class="form-row">
                <div class="form-group" style="flex:1;">
                    <input type="text" name="body" id="messageContent" class="form-control" placeholder="@T["TypeMessage"]" required autocomplete="off" />
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-primary">@T["Send"]</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Scroll to bottom
        (function () {
            var box = document.getElementById('chatBox');
            if (box) box.scrollTop = box.scrollHeight;
        })();

        // Auto-refresh every 5 seconds
        setInterval(function () {
            window.location.reload();
        }, 5000);
    </script>
}
