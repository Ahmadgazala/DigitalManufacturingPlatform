@model ManufacturingRequest
@{
    ViewData["Title"] = Model.Title;
    var isOpen = Model.Status == RequestStatus.Open;
}

<div class="page-header">
    <div class="container">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <h1>@Model.Title</h1>
            <span class="chip @(isOpen ? "chip-green" : Model.Status == RequestStatus.Completed ? "chip-steel" : "chip")">
                @Model.Status.ToArabic()
            </span>
        </div>
    </div>
</div>

<div class="container section">
    <div class="detail-grid">
        <div>
            <div class="panel">
                <h2>تفاصيل الطلب</h2>
                <ul class="info-list">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <li><span class="k">الوصف</span><span class="v">@Model.Description</span></li>
                    }
                    <li><span class="k">نوع التصنيع</span><span class="v">@Model.Category.ToArabic()</span></li>
                    @if (!string.IsNullOrEmpty(Model.Material))
                    {
                        <li><span class="k">المادة</span><span class="v">@Model.Material</span></li>
                    }
                    <li><span class="k">الكمية</span><span class="v">@Model.Quantity</span></li>
                    @if (Model.Budget.HasValue)
                    {
                        <li><span class="k">الميزانية</span><span class="v">@Model.Budget.Value.ToString("N0") د.أ</span></li>
                    }
                    <li><span class="k">تاريخ الطلب</span><span class="v">@Model.CreatedAt.ToString("yyyy/MM/dd")</span></li>
                </ul>

                @if (Model.Files.Any())
                {
                    <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line)">
                        <div style="font-weight:700;font-size:.88rem;margin-bottom:8px">الملفات المرفقة</div>
                        @foreach (var f in Model.Files)
                        {
                            <a href="@f.FilePath" target="_blank" style="display:block;font-size:.85rem;color:var(--sky);margin-bottom:4px">
                                📎 @f.OriginalFileName
                            </a>
                        }
                    </div>
                }

                @if (isOpen)
                {
                    <form asp-controller="Requests" asp-action="MarkCompleted" asp-route-id="@Model.Id" method="post" style="margin-top:16px">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary"
                                onclick="return confirm('هل أنت متأكد من تأشير الطلب كمكتمل؟')">
                            ✅ اكتمل التنفيذ
                        </button>
                    </form>
                }
            </div>

            <div class="panel">
                <h2>عروض الأسعار (@Model.Quotations.Count)</h2>
                @if (Model.Quotations.Any())
                {
                    <div class="quot-list">
                        @foreach (var q in Model.Quotations.OrderByDescending(x => x.CreatedAt))
                        {
                            var qCls = q.Status switch {
                                QuotationStatus.Accepted => "qs-accepted",
                                QuotationStatus.Rejected => "qs-rejected",
                                _ => "qs-pending"
                            };
                            <div class="quot-row">
                                <div class="quot-info">
                                    <div class="quot-title">@(q.Manufacturer?.WorkshopName ?? "مصنّع")</div>
                                    <div class="quot-meta">
                                        <span>💰 @q.Price.ToString("N0") د.أ</span>
                                        <span>⏱ @q.EstimatedDays يوم</span>
                                        @if (!string.IsNullOrEmpty(q.Notes)) { <span>📝 @q.Notes</span> }
                                        <span class="quot-date">@q.CreatedAt.ToString("yyyy/MM/dd")</span>
                                    </div>
                                </div>
                                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                                    <span class="quot-status @qCls">@q.Status.ToArabic()</span>
                                    @if (isOpen && q.Status == QuotationStatus.Pending)
                                    {
                                        <div style="display:flex;gap:6px">
                                            <form asp-controller="Quotations" asp-action="Accept" asp-route-id="@q.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary">قبول</button>
                                            </form>
                                            <form asp-controller="Quotations" asp-action="Reject" asp-route-id="@q.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">رفض</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="dc-empty">
                        <span>💬</span>
                        <p>لا توجد عروض أسعار بعد</p>
                    </div>
                }
            </div>
        </div>

        <aside>
            <div class="panel">
                <ul class="info-list">
                    <li><span class="k">الحالة</span><span class="v">@Model.Status.ToArabic()</span></li>
                    <li><span class="k">عدد العروض</span><span class="v fw-bold">@Model.Quotations.Count</span></li>
                </ul>
            </div>
            <a class="btn btn-outline btn-block" asp-controller="Requests" asp-action="Index">← طلباتي</a>
        </aside>
    </div>
</div>
