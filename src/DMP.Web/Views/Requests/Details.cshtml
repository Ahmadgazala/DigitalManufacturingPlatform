@model ManufacturingRequest
@{
    ViewData["Title"] = Model.Title;
    var isOpen       = Model.Status == RequestStatus.Open;
    var isInProgress = Model.Status == RequestStatus.InProgress;
    var isCompleted  = Model.Status == RequestStatus.Completed;
    var acceptedQ    = Model.Quotations.FirstOrDefault(q => q.Status == QuotationStatus.Accepted);
    var stages       = new[] { TrackingStage.Received, TrackingStage.InManufacturing, TrackingStage.ReadyForPickup, TrackingStage.Delivered };
}

<div class="page-header">
    <div class="container">
        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap">
            <h1>@Model.Title</h1>
            <span class="chip @(isOpen ? "chip-green" : isCompleted ? "chip-steel" : "chip-blue")">
                @Model.Status.ToArabic()
            </span>
            @if (!Model.IsApproved)
            {
                <span class="chip chip-amber">@T["⏳ بانتظار الاعتماد"]</span>
            }
            else
            {
                <span class="chip chip-green">@T["✓ معتمد"]</span>
            }
            @if (Model.PaymentStatus == PaymentStatus.Paid)
            {
                <span class="chip chip-green">@T["💳 مدفوع"]</span>
            }
        </div>
        <p>@Model.CreatedAt.ToString("yyyy/MM/dd")</p>
    </div>
</div>

<div class="container section">
    <div class="detail-grid">
        <div>

            <!-- ── تتبع الطلب ── -->
            @if (isInProgress || isCompleted)
            {
                <div class="panel">
                    <h2>@T["📍 تتبع الطلب"]</h2>
                    <div class="tracking-timeline">
                        @foreach (var s in stages)
                        {
                            var isDone    = Model.TrackingStage.HasValue && (int)Model.TrackingStage >= (int)s;
                            var isCurrent = Model.TrackingStage == s;
                            var update    = Model.OrderUpdates.LastOrDefault(u => u.Stage == s);
                            <div class="track-step @(isDone ? "done" : "") @(isCurrent ? "current" : "")">
                                <div class="track-icon">@s.ToIcon()</div>
                                <div class="track-body">
                                    <div class="track-label">@s.ToArabic()</div>
                                    @if (update != null)
                                    {
                                        @if (!string.IsNullOrEmpty(update.Note))
                                        {
                                            <div class="track-note">@update.Note</div>
                                        }
                                        <div class="track-date">@update.CreatedAt.ToString("yyyy/MM/dd — HH:mm")</div>
                                    }
                                </div>
                                @if (isDone)
                                {
                                    <span class="track-check">✓</span>
                                }
                            </div>
                        }
                    </div>

                    @if (isInProgress && !isCompleted)
                    {
                        <form asp-controller="Requests" asp-action="MarkCompleted" asp-route-id="@Model.Id" method="post" style="margin-top:16px">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary"
                                    onclick="return confirm('@T["هل استلمت طلبك وتريد تأشيره كمكتمل؟"]')">
                                @T["✅ تأكيد الاستلام"]
                            </button>
                        </form>
                    }
                </div>
            }

            <!-- ── الدفع الإلكتروني ── -->
            @if (acceptedQ != null && Model.PaymentStatus != PaymentStatus.Paid)
            {
                <div class="panel" style="border-color:rgba(14,165,233,.3);background:var(--sky-light)">
                    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
                        <div>
                            <div style="font-weight:800;font-size:1rem;color:var(--navy);margin-bottom:4px">
                                @T["💳 ادفع الآن لبدء التصنيع"]
                            </div>
                            <div style="font-size:.88rem;color:var(--steel)">
                                @T["المبلغ:"] <strong style="color:var(--sky-dark)">@acceptedQ.Price.ToString("N2") $</strong>
                                @T["— عبر CliQ (آمن ومشفّر)"]
                            </div>
                        </div>
                        <a asp-controller="Payments" asp-action="Checkout"
                           asp-route-requestId="@Model.Id"
                           class="btn btn-primary">@T["💳 ادفع الآن"]</a>
                    </div>
                </div>
            }
            @if (Model.PaymentStatus == PaymentStatus.Paid && Model.PaidAt.HasValue)
            {
                <div class="panel" style="border-color:var(--green-bd);background:var(--green-bg)">
                    <div style="display:flex;align-items:center;gap:10px">
                        <span style="font-size:1.5rem">✅</span>
                        <div>
                            <div style="font-weight:800;color:#065f46">@T["تم الدفع بنجاح"]</div>
                            <div style="font-size:.82rem;color:#059669">
                                @T["المبلغ: {0} $ — {1}", (Model.PaidAmount?.ToString("N2") ?? "0.00"), Model.PaidAt.Value.ToString("yyyy/MM/dd")]
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- ── تفاصيل الطلب ── -->
            <div class="panel">
                <h2>@T["تفاصيل الطلب"]</h2>
                <ul class="info-list">
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <li><span class="k">@T["الوصف"]</span><span class="v">@Model.Description</span></li>
                    }
                        <li><span class="k">@T["نوع التصنيع"]</span><span class="v">@Model.Category.ToArabic()</span></li>
                    @if (!string.IsNullOrEmpty(Model.Material))
                    {
                        <li><span class="k">@T["المادة"]</span><span class="v">@Model.Material</span></li>
                    }
                        <li><span class="k">@T["الكمية"]</span><span class="v">@Model.Quantity</span></li>
                    @if (Model.Budget.HasValue)
                    {
                        <li><span class="k">@T["الميزانية"]</span><span class="v">@T["{0} د.أ", Model.Budget.Value.ToString("N0")]</span></li>
                    }
                        <li><span class="k">@T["تاريخ الطلب"]</span><span class="v">@Model.CreatedAt.ToString("yyyy/MM/dd")</span></li>
                </ul>

                @if (Model.Files.Any())
                {
                    <div style="margin-top:14px;padding-top:14px;border-top:1px solid var(--line)">
                        <div style="font-weight:700;font-size:.88rem;margin-bottom:8px">@T["الملفات المرفقة"]</div>
                        <ul class="file-list">
                            @foreach (var f in Model.Files)
                            {
                                <li>📎 <a href="@f.FilePath" target="_blank">@f.OriginalFileName</a></li>
                            }
                        </ul>
                    </div>
                }
            </div>

            <!-- ── عروض الأسعار ── -->
            <div class="panel">
                <h2>@T["عروض الأسعار ({0})", Model.Quotations.Count]</h2>
                @if (Model.Quotations.Any())
                {
                    <div class="quot-list">
                        @foreach (var q in Model.Quotations.OrderByDescending(x => x.CreatedAt))
                        {
                            var qCls = q.Status switch {
                                QuotationStatus.Accepted => "qs-accepted",
                                QuotationStatus.Rejected => "qs-rejected",
                                _ => "qs-pending"
                            };
                            <div class="quot-row">
                                <div class="quot-info">
                                    <div class="quot-title">@(q.Manufacturer?.WorkshopName ?? T["مصنّع"])</div>
                                    <div class="quot-meta">
                                        <span>@T["💰 {0} د.أ", q.Price.ToString("N0")]</span>
                                        <span>@T["⏱ {0} يوم", q.EstimatedDays]</span>
                                        @if (!string.IsNullOrEmpty(q.Notes)) { <span>📝 @q.Notes</span> }
                                        <span class="quot-date">@q.CreatedAt.ToString("yyyy/MM/dd")</span>
                                    </div>
                                </div>
                                <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px">
                                    <span class="quot-status @qCls">@q.Status.ToArabic()</span>
                                    @if (isOpen && q.Status == QuotationStatus.Pending)
                                    {
                                        <div style="display:flex;gap:6px">
                                            <form asp-controller="Quotations" asp-action="Accept" asp-route-id="@q.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-primary">@T["قبول"]</button>
                                            </form>
                                            <form asp-controller="Quotations" asp-action="Reject" asp-route-id="@q.Id" method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-danger">@T["رفض"]</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="dc-empty">
                        <span>💬</span>
                        <p>@T["لا توجد عروض أسعار بعد. سيتواصل معك المصنّعون قريباً."]</p>
                    </div>
                }
            </div>
        </div>

        <!-- ── Sidebar ── -->
        <aside>
            <div class="panel">
                <ul class="info-list">
                    <li><span class="k">@T["الحالة"]</span><span class="v">@Model.Status.ToArabic()</span></li>
                    <li><span class="k">@T["الاعتماد"]</span>
                        <span class="v">
                            @if (Model.IsApproved)
                            { <span class="chip chip-green">@T["✓ معتمد"]</span> }
                            else
                            { <span class="chip chip-amber">@T["⏳ بانتظار الاعتماد"]</span> }
                        </span>
                    </li>
                    @if (Model.TrackingStage.HasValue)
                    {
                        <li><span class="k">@T["مرحلة التتبع"]</span>
                            <span class="v">@Model.TrackingStage.Value.ToIcon() @Model.TrackingStage.Value.ToArabic()</span>
                        </li>
                    }
                    <li><span class="k">@T["الدفع"]</span>
                        <span class="v">
                            @if (Model.PaymentStatus == PaymentStatus.Paid)
                            { <span class="chip chip-green">@T["مدفوع ✓"]</span> }
                            else if (Model.PaymentStatus == PaymentStatus.Pending)
                            { <span class="chip chip-amber">@T["بانتظار الدفع"]</span> }
                            else
                            { <span class="chip">@T["غير مدفوع"]</span> }
                        </span>
                    </li>
                    <li><span class="k">@T["عدد العروض"]</span><span class="v fw-bold">@Model.Quotations.Count</span></li>
                </ul>
            </div>
            <a class="btn btn-outline btn-block" asp-controller="Requests" asp-action="Index">@T["← طلباتي"]</a>
        </aside>
    </div>
</div>
