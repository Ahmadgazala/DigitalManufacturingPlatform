@model List<ManufacturingRequest>
@{
    ViewData["Title"] = T["طلباتي"];
}

<div class="page-header">
    <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
            <div>
                <h1>@T["طلباتي"]</h1>
                <p>@T["تتبّع طلبات التصنيع الخاصة بك"]</p>
            </div>
            <a asp-controller="Requests" asp-action="Create" class="btn btn-primary">@T["+ طلب جديد"]</a>
        </div>
    </div>
</div>

<div class="container section">
    @if (Model.Any())
    {
        <div class="req-list">
            @foreach (var req in Model.OrderByDescending(r => r.CreatedAt))
            {
                var statusCls = req.Status switch {
                    RequestStatus.Open       => "chip-green",
                    RequestStatus.InProgress => "chip",
                    RequestStatus.Completed  => "chip-steel",
                    RequestStatus.Cancelled  => "chip-red",
                    _ => "chip"
                };
                <div class="req-row">
                    <div class="req-info">
                        <div class="req-top">
                            <a asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id" class="req-title">@req.Title</a>
                            <span class="chip @statusCls">@req.Status.ToArabic()</span>
                            @if (!req.IsApproved)
                            {
                                <span class="chip chip-amber">@T["⏳ بانتظار الاعتماد"]</span>
                            }
                            <span class="chip chip-cat">@req.Category.ToArabic()</span>
                        </div>
                        <div class="req-meta">
                            <span>@T["📦 كمية: {0}", req.Quantity]</span>
                            @if (req.Budget.HasValue) { <span>@T["💰 {0} د.أ", req.Budget.Value.ToString("N0")]</span> }
                            <span class="req-date">@req.CreatedAt.ToString("yyyy/MM/dd")</span>
                            <span>@T["💬 {0} عرض", req.Quotations.Count]</span>
                        </div>
                    </div>
                    <a class="btn btn-sm btn-outline" asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id">@T["عرض"]</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="ico">📋</div>
            <h3>@T["لا توجد طلبات بعد"]</h3>
            <p>@T["أنشئ طلب تصنيع وسيتواصل معك المصنّعون بعروض أسعار"]</p>
            <a asp-controller="Requests" asp-action="Create" class="btn btn-primary">@T["+ طلب جديد"]</a>
        </div>
    }
</div>
