@model List<ManufacturingRequest>
@{
    ViewData["Title"] = "طلباتي";
}

<div class="page-header">
    <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
            <div>
                <h1>طلباتي</h1>
                <p>تتبّع طلبات التصنيع الخاصة بك</p>
            </div>
            <a asp-controller="Requests" asp-action="Create" class="btn btn-primary">+ طلب جديد</a>
        </div>
    </div>
</div>

<div class="container section">
    @if (Model.Any())
    {
        <div class="req-list">
            @foreach (var req in Model.OrderByDescending(r => r.CreatedAt))
            {
                var statusCls = req.Status switch {
                    RequestStatus.Open       => "chip-green",
                    RequestStatus.InProgress => "chip",
                    RequestStatus.Completed  => "chip-steel",
                    RequestStatus.Cancelled  => "chip-red",
                    _ => "chip"
                };
                <div class="req-row">
                    <div class="req-info">
                        <div class="req-top">
                            <a asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id" class="req-title">@req.Title</a>
                            <span class="chip @statusCls">@req.Status.ToArabic()</span>
                            <span class="chip chip-cat">@req.Category.ToArabic()</span>
                        </div>
                        <div class="req-meta">
                            <span>📦 كمية: @req.Quantity</span>
                            @if (req.Budget.HasValue) { <span>💰 @req.Budget.Value.ToString("N0") د.أ</span> }
                            <span class="req-date">@req.CreatedAt.ToString("yyyy/MM/dd")</span>
                            <span>💬 @req.Quotations.Count عرض</span>
                        </div>
                    </div>
                    <a class="btn btn-sm btn-outline" asp-controller="Requests" asp-action="Details" asp-route-id="@req.Id">عرض</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="ico">📋</div>
            <h3>لا توجد طلبات بعد</h3>
            <p>أنشئ طلب تصنيع وسيتواصل معك المصنّعون بعروض أسعار</p>
            <a asp-controller="Requests" asp-action="Create" class="btn btn-primary">+ طلب جديد</a>
        </div>
    }
</div>
