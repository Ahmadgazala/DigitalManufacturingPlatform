@model Manufacturer
@{
    double avgRating = Model.Reviews != null && Model.Reviews.Any()
        ? Model.Reviews.Average(r => r.Rating)
        : 0;
    int reviewCount = Model.Reviews?.Count ?? 0;

    // Pick cover style based on ID for visual variety
    int coverStyle = (Model.Id % 5);
}

<div class="mfr-card">
    <div class="mfr-card-cover">
        @if (!string.IsNullOrEmpty(Model.CoverPhotoPath))
        {
            <img src="@Model.CoverPhotoPath" alt="@Model.WorkshopName" class="mfr-cover-img" loading="lazy" />
        }
        else
        {
            <!-- Manufacturing-themed SVG cover, style rotates by ID -->
            <div class="mfr-cover-svg" data-style="@coverStyle">
                @switch (coverStyle)
                {
                    case 0:
                        <!-- CNC theme: coordinate grid + tool path -->
                        <svg viewBox="0 0 400 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%">
                            <rect width="400" height="140" fill="#071828"/>
                            <defs>
                                <pattern id="g0" width="20" height="20" patternUnits="userSpaceOnUse">
                                    <path d="M 20 0 L 0 0 0 20" fill="none" stroke="rgba(14,165,233,0.1)" stroke-width="0.8"/>
                                </pattern>
                            </defs>
                            <rect width="400" height="140" fill="url(#g0)"/>
                            <ellipse cx="200" cy="70" rx="160" ry="80" fill="rgba(14,165,233,0.05)"/>
                            <!-- Tool path -->
                            <path d="M 60 100 Q 120 40 200 70 Q 280 100 340 45" fill="none" stroke="#0ea5e9" stroke-width="2" stroke-dasharray="6 4" opacity="0.7"/>
                            <!-- Tool head -->
                            <circle cx="340" cy="45" r="8" fill="none" stroke="#0ea5e9" stroke-width="2"/>
                            <circle cx="340" cy="45" r="3" fill="#0ea5e9" opacity="0.8"/>
                            <!-- Axis lines -->
                            <line x1="40" y1="20" x2="40" y2="120" stroke="#ef4444" stroke-width="1.5" opacity="0.5"/>
                            <line x1="40" y1="120" x2="360" y2="120" stroke="#22c55e" stroke-width="1.5" opacity="0.5"/>
                            <text x="42" y="16" fill="#ef4444" font-size="9" font-family="monospace" opacity="0.7">Y</text>
                            <text x="362" y="123" fill="#22c55e" font-size="9" font-family="monospace" opacity="0.7">X</text>
                            <!-- Label -->
                            <rect x="12" y="12" width="60" height="18" rx="4" fill="rgba(14,165,233,0.15)" stroke="rgba(14,165,233,0.3)" stroke-width="1"/>
                            <text x="42" y="25" fill="#0ea5e9" font-size="9" font-family="monospace" text-anchor="middle" font-weight="bold">CNC</text>
                        </svg>
                        break;

                    case 1:
                        <!-- 3D Printing theme: layered staircase -->
                        <svg viewBox="0 0 400 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%">
                            <rect width="400" height="140" fill="#071828"/>
                            <defs>
                                <pattern id="g1" width="16" height="16" patternUnits="userSpaceOnUse">
                                    <path d="M 16 0 L 0 0 0 16" fill="none" stroke="rgba(6,182,212,0.08)" stroke-width="0.8"/>
                                </pattern>
                            </defs>
                            <rect width="400" height="140" fill="url(#g1)"/>
                            <ellipse cx="200" cy="70" rx="140" ry="70" fill="rgba(6,182,212,0.05)"/>
                            <!-- 3D printed layers (isometric style) -->
                            <g transform="translate(145, 25)">
                                <rect x="0" y="80" width="110" height="12" rx="2" fill="rgba(6,182,212,0.15)" stroke="#06b6d4" stroke-width="1.5"/>
                                <rect x="5" y="68" width="100" height="12" rx="2" fill="rgba(6,182,212,0.18)" stroke="#06b6d4" stroke-width="1.5"/>
                                <rect x="12" y="56" width="86" height="12" rx="2" fill="rgba(6,182,212,0.22)" stroke="#06b6d4" stroke-width="1.5"/>
                                <rect x="20" y="44" width="70" height="12" rx="2" fill="rgba(6,182,212,0.28)" stroke="#06b6d4" stroke-width="1.5"/>
                                <rect x="28" y="32" width="54" height="12" rx="2" fill="rgba(6,182,212,0.34)" stroke="#06b6d4" stroke-width="1.5"/>
                                <rect x="36" y="20" width="38" height="12" rx="2" fill="rgba(6,182,212,0.42)" stroke="#06b6d4" stroke-width="1.5"/>
                                <rect x="44" y="8" width="22" height="12" rx="2" fill="rgba(6,182,212,0.55)" stroke="#06b6d4" stroke-width="2"/>
                                <!-- Extruder tip -->
                                <line x1="55" y1="0" x2="55" y2="9" stroke="#06b6d4" stroke-width="2.5" stroke-linecap="round"/>
                                <circle cx="55" cy="0" r="4" fill="#06b6d4" opacity="0.9"/>
                            </g>
                            <!-- Label -->
                            <rect x="12" y="12" width="90" height="18" rx="4" fill="rgba(6,182,212,0.15)" stroke="rgba(6,182,212,0.3)" stroke-width="1"/>
                            <text x="57" y="25" fill="#06b6d4" font-size="9" font-family="monospace" text-anchor="middle" font-weight="bold">3D PRINTING</text>
                        </svg>
                        break;

                    case 2:
                        <!-- Laser cutting theme: beam + material -->
                        <svg viewBox="0 0 400 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%">
                            <rect width="400" height="140" fill="#071828"/>
                            <defs>
                                <pattern id="g2" width="18" height="18" patternUnits="userSpaceOnUse">
                                    <path d="M 18 0 L 0 0 0 18" fill="none" stroke="rgba(245,158,11,0.08)" stroke-width="0.8"/>
                                </pattern>
                                <radialGradient id="laserGlow" cx="50%" cy="0%" r="80%">
                                    <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.35"/>
                                    <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
                                </radialGradient>
                            </defs>
                            <rect width="400" height="140" fill="url(#g2)"/>
                            <rect width="400" height="140" fill="url(#laserGlow)"/>
                            <!-- Material sheet -->
                            <rect x="60" y="95" width="280" height="20" rx="3" fill="#0d2035" stroke="#374151" stroke-width="1.5"/>
                            <!-- Cut shapes (already cut) -->
                            <rect x="90" y="95" width="30" height="20" rx="2" fill="#020c18" stroke="#f59e0b" stroke-width="1" opacity="0.8"/>
                            <circle cx="175" cy="105" r="12" fill="#020c18" stroke="#f59e0b" stroke-width="1" opacity="0.8"/>
                            <polygon points="230,95 260,95 245,115" fill="#020c18" stroke="#f59e0b" stroke-width="1" opacity="0.8"/>
                            <!-- Active laser beam -->
                            <line x1="310" y1="10" x2="310" y2="95" stroke="#f59e0b" stroke-width="2" opacity="0.9"/>
                            <line x1="305" y1="10" x2="310" y2="95" stroke="#fbbf24" stroke-width="1" opacity="0.4"/>
                            <line x1="315" y1="10" x2="310" y2="95" stroke="#fbbf24" stroke-width="1" opacity="0.4"/>
                            <!-- Laser head -->
                            <rect x="296" y="5" width="28" height="18" rx="4" fill="#142840" stroke="#f59e0b" stroke-width="1.5"/>
                            <circle cx="310" cy="14" r="4" fill="none" stroke="#f59e0b" stroke-width="1.5"/>
                            <!-- Spark at cut point -->
                            <circle cx="310" cy="95" r="5" fill="#f59e0b" opacity="0.7"/>
                            <circle cx="310" cy="95" r="10" fill="#f59e0b" opacity="0.15"/>
                            <!-- Label -->
                            <rect x="12" y="12" width="80" height="18" rx="4" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.3)" stroke-width="1"/>
                            <text x="52" y="25" fill="#f59e0b" font-size="9" font-family="monospace" text-anchor="middle" font-weight="bold">LASER CUT</text>
                        </svg>
                        break;

                    case 3:
                        <!-- Workshop / fabrication theme: gears + tools -->
                        <svg viewBox="0 0 400 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%">
                            <rect width="400" height="140" fill="#071828"/>
                            <defs>
                                <pattern id="g3" width="22" height="22" patternUnits="userSpaceOnUse">
                                    <circle cx="1" cy="1" r="1" fill="rgba(139,92,246,0.12)"/>
                                </pattern>
                            </defs>
                            <rect width="400" height="140" fill="url(#g3)"/>
                            <ellipse cx="200" cy="70" rx="150" ry="75" fill="rgba(139,92,246,0.05)"/>
                            <!-- Large gear -->
                            <g transform="translate(180,70)">
                                <circle cx="0" cy="0" r="40" fill="none" stroke="#8b5cf6" stroke-width="2" opacity="0.5"/>
                                <circle cx="0" cy="0" r="15" fill="none" stroke="#8b5cf6" stroke-width="2" opacity="0.7"/>
                                <!-- Gear teeth (simplified) -->
                                @for (int t = 0; t < 12; t++)
                                {
                                    double angle = t * 30 * Math.PI / 180;
                                    double x1 = Math.Cos(angle) * 38;
                                    double y1 = Math.Sin(angle) * 38;
                                    double x2 = Math.Cos(angle) * 48;
                                    double y2 = Math.Sin(angle) * 48;
                                    <line x1="@x1.ToString("F1")" y1="@y1.ToString("F1")" x2="@x2.ToString("F1")" y2="@y2.ToString("F1")" stroke="#8b5cf6" stroke-width="5" stroke-linecap="square" opacity="0.6"/>
                                }
                            </g>
                            <!-- Small gear -->
                            <g transform="translate(260,35)">
                                <circle cx="0" cy="0" r="22" fill="none" stroke="#06b6d4" stroke-width="1.5" opacity="0.5"/>
                                <circle cx="0" cy="0" r="8" fill="none" stroke="#06b6d4" stroke-width="1.5" opacity="0.7"/>
                                @for (int t = 0; t < 8; t++)
                                {
                                    double angle = t * 45 * Math.PI / 180;
                                    double x1 = Math.Cos(angle) * 20;
                                    double y1 = Math.Sin(angle) * 20;
                                    double x2 = Math.Cos(angle) * 28;
                                    double y2 = Math.Sin(angle) * 28;
                                    <line x1="@x1.ToString("F1")" y1="@y1.ToString("F1")" x2="@x2.ToString("F1")" y2="@y2.ToString("F1")" stroke="#06b6d4" stroke-width="4" stroke-linecap="square" opacity="0.6"/>
                                }
                            </g>
                            <!-- Wrench -->
                            <g transform="translate(100,75) rotate(-35)">
                                <rect x="-4" y="-30" width="8" height="50" rx="3" fill="#374151" stroke="#6b7280" stroke-width="1"/>
                                <circle cx="0" cy="-30" r="12" fill="none" stroke="#6b7280" stroke-width="2"/>
                                <circle cx="0" cy="-30" r="5" fill="none" stroke="#6b7280" stroke-width="2"/>
                            </g>
                            <!-- Label -->
                            <rect x="12" y="12" width="76" height="18" rx="4" fill="rgba(139,92,246,0.15)" stroke="rgba(139,92,246,0.3)" stroke-width="1"/>
                            <text x="50" y="25" fill="#8b5cf6" font-size="9" font-family="monospace" text-anchor="middle" font-weight="bold">WORKSHOP</text>
                        </svg>
                        break;

                    default:
                        <!-- Sheet metal / fabrication theme -->
                        <svg viewBox="0 0 400 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="width:100%;height:100%">
                            <rect width="400" height="140" fill="#071828"/>
                            <defs>
                                <pattern id="g4" width="24" height="24" patternUnits="userSpaceOnUse">
                                    <rect x="0" y="0" width="12" height="12" fill="rgba(16,185,129,0.05)"/>
                                    <rect x="12" y="12" width="12" height="12" fill="rgba(16,185,129,0.05)"/>
                                </pattern>
                            </defs>
                            <rect width="400" height="140" fill="url(#g4)"/>
                            <ellipse cx="200" cy="70" rx="160" ry="80" fill="rgba(16,185,129,0.04)"/>
                            <!-- Blueprint lines -->
                            <rect x="80" y="30" width="240" height="80" rx="4" fill="none" stroke="#10b981" stroke-width="1.5" stroke-dasharray="6 3" opacity="0.6"/>
                            <!-- Dimensions -->
                            <line x1="80" y1="22" x2="320" y2="22" stroke="#10b981" stroke-width="1" opacity="0.5"/>
                            <line x1="80" y1="18" x2="80" y2="26" stroke="#10b981" stroke-width="1" opacity="0.5"/>
                            <line x1="320" y1="18" x2="320" y2="26" stroke="#10b981" stroke-width="1" opacity="0.5"/>
                            <text x="200" y="20" fill="#10b981" font-size="9" font-family="monospace" text-anchor="middle" opacity="0.8">240 mm</text>
                            <line x1="72" y1="30" x2="72" y2="110" stroke="#10b981" stroke-width="1" opacity="0.5"/>
                            <line x1="68" y1="30" x2="76" y2="30" stroke="#10b981" stroke-width="1" opacity="0.5"/>
                            <line x1="68" y1="110" x2="76" y2="110" stroke="#10b981" stroke-width="1" opacity="0.5"/>
                            <text x="62" y="74" fill="#10b981" font-size="9" font-family="monospace" text-anchor="middle" opacity="0.8" transform="rotate(-90,62,74)">80 mm</text>
                            <!-- Corner radius marks -->
                            <path d="M 90 30 Q 80 30 80 40" fill="none" stroke="#10b981" stroke-width="1" opacity="0.8"/>
                            <path d="M 310 30 Q 320 30 320 40" fill="none" stroke="#10b981" stroke-width="1" opacity="0.8"/>
                            <path d="M 90 110 Q 80 110 80 100" fill="none" stroke="#10b981" stroke-width="1" opacity="0.8"/>
                            <path d="M 310 110 Q 320 110 320 100" fill="none" stroke="#10b981" stroke-width="1" opacity="0.8"/>
                            <!-- Center cross -->
                            <line x1="185" y1="70" x2="215" y2="70" stroke="#10b981" stroke-width="1" opacity="0.6"/>
                            <line x1="200" y1="55" x2="200" y2="85" stroke="#10b981" stroke-width="1" opacity="0.6"/>
                            <circle cx="200" cy="70" r="4" fill="none" stroke="#10b981" stroke-width="1" opacity="0.6"/>
                            <!-- Label -->
                            <rect x="12" y="12" width="76" height="18" rx="4" fill="rgba(16,185,129,0.15)" stroke="rgba(16,185,129,0.3)" stroke-width="1"/>
                            <text x="50" y="25" fill="#10b981" font-size="9" font-family="monospace" text-anchor="middle" font-weight="bold">BLUEPRINT</text>
                        </svg>
                        break;
                }
            </div>
        }

        @if (Model.IsApproved)
        {
            <span class="chip chip-green mfr-badge">
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                @T["Verified"]
            </span>
        }
    </div>

    <div class="mfr-card-body">
        <div class="mfr-card-avatar">
            @if (!string.IsNullOrEmpty(Model.ProfilePhotoPath))
            {
                <img src="@Model.ProfilePhotoPath" alt="@Model.WorkshopName" />
            }
            else
            {
                <div class="avatar-placeholder">@(Model.WorkshopName?.Length > 0 ? Model.WorkshopName.Substring(0, 1) : "?")</div>
            }
        </div>

        <h3 class="mfr-card-name">@Model.WorkshopName</h3>

        @if (!string.IsNullOrEmpty(Model.City))
        {
            <p class="mfr-card-city">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                @Model.City
            </p>
        }

        @if (reviewCount > 0)
        {
            <div class="star-rating mfr-rating" style="margin-bottom:8px">
                @for (int i = 1; i <= 5; i++)
                {
                    <span class="@(i <= Math.Round(avgRating) ? "star filled" : "star")">&#9733;</span>
                }
                <span class="rating-count">(@reviewCount)</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Bio))
        {
            <p class="mfr-card-bio">@(Model.Bio.Length > 90 ? Model.Bio.Substring(0, 90) + "..." : Model.Bio)</p>
        }

        <div class="mfr-card-chips">
            @if (Model.Delivery != DeliveryOption.PickupOnly)
            {
                <span class="chip chip-green">توصيل</span>
            }
            @if (Model.Machines != null && Model.Machines.Any())
            {
                <span class="chip">@Model.Machines.Count @T["Machines"]</span>
            }
        </div>

        <a asp-controller="Manufacturers" asp-action="Details" asp-route-id="@Model.Id"
           class="btn btn-outline btn-sm mfr-card-link">@T["ViewWorkshop"]</a>
    </div>
</div>
