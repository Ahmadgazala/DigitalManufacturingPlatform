<!DOCTYPE html>
<html lang="@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en") ? "en" : "ar")"
      dir="@(System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("en") ? "ltr" : "rtl")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Jo Maker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>

<nav class="navbar">
    <div class="container nav-inner">
        <a class="nav-brand" asp-controller="Home" asp-action="Index">
            <span class="brand-icon">⚙</span>
            <span>Jo Maker</span>
        </a>

        <button class="nav-toggle" id="navToggle" aria-label="القائمة">
            <span></span><span></span><span></span>
        </button>

        <ul class="nav-links" id="navLinks">
            <li><a asp-controller="Home" asp-action="Index">@T["Nav_Home"]</a></li>
            <li><a asp-controller="Manufacturers" asp-action="Index">@T["Nav_Manufacturers"]</a></li>
            <li><a asp-controller="Manufacturers" asp-action="Map">🗺️ الخريطة</a></li>
            <li><a asp-controller="Suppliers" asp-action="Index">@T["Nav_Suppliers"]</a></li>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <li><a asp-controller="Requests" asp-action="Index">@T["Nav_Requests"]</a></li>
                <li><a asp-controller="Messages" asp-action="Inbox">@T["Nav_Messages"]</a></li>
            }
            @if (User.IsInRole("Manufacturer") || User.IsInRole("Admin"))
            {
                <li><a asp-controller="GroupBuying" asp-action="Index">@T["Nav_GroupBuying"]</a></li>
            }
        </ul>

        <div class="nav-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-bell" asp-controller="Notifications" asp-action="Index">
                    🔔 <span class="bell-badge" id="bellBadge" style="display:none">0</span>
                </a>
                @if (User.IsInRole("Manufacturer"))
                {
                    <a class="btn btn-outline btn-sm" asp-controller="Manufacturers" asp-action="Dashboard">@T["Nav_Dashboard"]</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-outline btn-sm" asp-controller="Admin" asp-action="Index">@T["Nav_Admin"]</a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-ghost" type="submit">@T["Nav_Logout"]</button>
                </form>
            }
            else
            {
                <a class="btn btn-outline btn-sm" asp-controller="Account" asp-action="Login">@T["Nav_Login"]</a>
                <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">@T["Nav_Register"]</a>
            }
            @{
                var isAr = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
            }
            <a asp-controller="Lang" asp-action="SetLanguage"
               asp-route-culture="@(isAr ? "en" : "ar")"
               asp-route-returnUrl="@Context.Request.Path"
               class="btn btn-ghost btn-sm lang-btn">@(isAr ? "EN" : "ع")</a>
        </div>
    </div>
</nav>

<main>
    @if (TempData["Success"] is string success)
    {
        <div class="container" style="padding-top:12px">
            <div class="alert alert-success">✓ @success</div>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="container" style="padding-top:12px">
            <div class="alert alert-error">⚠ @error</div>
        </div>
    }
    @RenderBody()
</main>

<footer class="footer">
    <div class="container footer-inner">
        <div class="footer-brand">
            <div style="font-size:1.4rem;font-weight:800;color:#fff;display:flex;align-items:center;gap:8px">
                <span>⚙</span> Jo Maker
            </div>
            <p style="color:#64748b;font-size:.85rem;margin-top:6px">منصة التصنيع الرقمي في الأردن</p>
        </div>
        <div class="footer-links">
            <a asp-controller="Manufacturers" asp-action="Index">دليل الورش</a>
            <a asp-controller="Manufacturers" asp-action="Map">🗺️ خريطة الورش</a>
            <a asp-controller="Suppliers" asp-action="Index">الموردون</a>
            <a asp-controller="Requests" asp-action="Create">اطلب تصنيعاً</a>
        </div>
        <div style="color:#475569;font-size:.82rem">
            © @DateTime.Now.Year Jo Maker — جميع الحقوق محفوظة
        </div>
    </div>
</footer>

<script>
    document.getElementById('navToggle')?.addEventListener('click', function () {
        document.getElementById('navLinks')?.classList.toggle('open');
    });
    @if (User.Identity?.IsAuthenticated == true)
    {
        <text>
        function fetchUnread() {
            fetch('/Notifications/GetUnread')
                .then(r => r.json())
                .then(d => {
                    var b = document.getElementById('bellBadge');
                    if (b) { b.textContent = d.count; b.style.display = d.count > 0 ? 'inline-flex' : 'none'; }
                }).catch(() => {});
        }
        fetchUnread();
        setInterval(fetchUnread, 30000);
        </text>
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
