@model RegisterViewModel
@{
    ViewData["Title"] = T["Register"];
}

<div class="container">
    <div class="auth-box">
        <div class="page-header">
            <h1>@T["Register"]</h1>
            <p>@T["RegisterSubtitle"]</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-controller="Account" asp-action="Register" method="post">
            @Html.AntiForgeryToken()

            @* اختيار نوع الحساب *@
            <div class="form-group" style="margin-bottom:24px">
                <label style="font-weight:700;margin-bottom:10px;display:block">نوع الحساب</label>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
                    <label class="role-card" id="card-customer">
                        <input type="radio" name="Role" value="Customer" checked style="display:none" />
                        <div class="role-card-inner">
                            <div class="role-icon">🏢</div>
                            <div class="role-title">عميل / شركة</div>
                            <div class="role-desc">أبحث عن خدمات تصنيع وأطلب عروض أسعار</div>
                        </div>
                    </label>
                    <label class="role-card" id="card-manufacturer">
                        <input type="radio" name="Role" value="Manufacturer" style="display:none" />
                        <div class="role-card-inner">
                            <div class="role-icon">⚙️</div>
                            <div class="role-title">مصنّع / ورشة</div>
                            <div class="role-desc">أملك ورشة وأقدم خدمات التصنيع</div>
                        </div>
                    </label>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="FullName">@T["FullName"]</label>
                <input asp-for="FullName" class="form-control" placeholder="@T["EnterFullName"]" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">@T["Email"]</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="@T["EnterEmail"]" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">@T["Password"]</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="@T["EnterPassword"]" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">@T["ConfirmPassword"]</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="@T["ConfirmYourPassword"]" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary" id="submitBtn">إنشاء حساب عميل</button>
            </div>

            <div class="auth-links">
                @T["AlreadyHaveAccount"] <a asp-controller="Account" asp-action="Login">@T["LoginHere"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var cards = document.querySelectorAll('.role-card');
        var radios = document.querySelectorAll('input[name="Role"]');
        var btn   = document.getElementById('submitBtn');

        var labels = {
            'Customer':     'إنشاء حساب عميل',
            'Manufacturer': 'إنشاء حساب مصنّع'
        };

        function update() {
            radios.forEach(function (r) {
                var card = r.closest('.role-card');
                card.classList.toggle('role-card-active', r.checked);
            });
            var selected = document.querySelector('input[name="Role"]:checked');
            if (selected && btn) btn.textContent = labels[selected.value] || 'إنشاء حساب';
        }

        cards.forEach(function (card) {
            card.addEventListener('click', function () {
                var radio = card.querySelector('input[type="radio"]');
                if (radio) { radio.checked = true; update(); }
            });
        });

        update();
    })();
</script>
}
