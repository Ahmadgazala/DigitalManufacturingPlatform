@model LoginViewModel
@{
    ViewData["Title"] = T["Login"];
}

<div class="container">
    <div class="auth-box">
        <div class="page-header">
            <h1>@T["Login"]</h1>
            <p>@T["LoginSubtitle"]</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-error">
                <ul>
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <li>@error.ErrorMessage</li>
                    }
                </ul>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@(Context.Request.Query["returnUrl"].FirstOrDefault() ?? "")" />

            <div class="form-group">
                <label asp-for="Email">@T["Email"]</label>
                <input asp-for="Email" class="form-control" type="email" placeholder="@T["EnterEmail"]" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">@T["Password"]</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="@T["EnterPassword"]" autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group form-check">
                <input asp-for="RememberMe" type="checkbox" id="RememberMe" />
                <label for="RememberMe">@T["RememberMe"]</label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">@T["LoginBtn"]</button>
            </div>

            <div class="auth-links">
                <a asp-controller="Account" asp-action="ForgotPassword">@T["ForgotPassword"]</a>
                <span class="separator">|</span>
                <a asp-controller="Account" asp-action="Register">@T["CreateAccount"]</a>
            </div>
        </form>
    </div>
</div>
