<script>
/* ── Printer Animation ───────────────────────────── */
(function () {
    var LAYERS = [
        { y:125, x:50,  w:120, dir: 1 },
        { y:117, x:54,  w:112, dir:-1 },
        { y:109, x:58,  w:104, dir: 1 },
        { y:101, x:62,  w: 96, dir:-1 },
        { y: 93, x:66,  w: 88, dir: 1 },
        { y: 85, x:70,  w: 80, dir:-1 },
    ];
    var PRINT_MS=1300, Z_MS=380, PAUSE_MS=2400, FADE_MS=700;
    var CYCLE = LAYERS.length*(PRINT_MS+Z_MS)+PAUSE_MS+FADE_MS;

    var ng  = document.getElementById('nozzleGrp');
    var rod = document.getElementById('xRod');
    var eg  = document.getElementById('extGlow');
    var eb  = document.getElementById('extBead');
    var svg = document.getElementById('printerSvg');
    var rects = LAYERS.map(function(_,i){ return document.getElementById('pl'+(i+1)); });

    function eio(t){ return t<.5?2*t*t:1-Math.pow(-2*t+2,2)/2; }
    function lerp(a,b,t){ return a+(b-a)*t; }
    function clamp(v,lo,hi){ return v<lo?lo:v>hi?hi:v; }

    function setLayer(i,p){
        var ld=LAYERS[i], el=rects[i]; if(!el) return;
        var w=Math.round(clamp(p,0,1)*ld.w);
        el.setAttribute('x', ld.dir===1 ? ld.x : ld.x+ld.w-w);
        el.setAttribute('width', w);
    }
    function setNozzle(x,y,printing){
        ng.setAttribute('transform','translate('+x+','+y+')');
        rod.setAttribute('y1',y-1); rod.setAttribute('y2',y-1);
        var o=printing?'1':'0'; eg.setAttribute('opacity',o); eb.setAttribute('opacity',o);
    }

    var t0=null;
    function frame(ts){
        if(!t0) t0=ts;
        var e=(ts-t0)%CYCLE, pp=LAYERS.length*(PRINT_MS+Z_MS);

        if(e<pp){
            svg.style.opacity='1';
            var li=Math.floor(e/(PRINT_MS+Z_MS)), le=e-li*(PRINT_MS+Z_MS), ld=LAYERS[li];
            for(var i=0;i<li;i++) setLayer(i,1);
            for(var j=li+1;j<LAYERS.length;j++) setLayer(j,0);
            if(le<=PRINT_MS){
                var t=eio(le/PRINT_MS);
                setLayer(li,t);
                setNozzle(ld.dir===1?ld.x+t*ld.w:ld.x+ld.w-t*ld.w, ld.y, true);
            } else {
                setLayer(li,1);
                var zt=(le-PRINT_MS)/Z_MS, nxt=LAYERS[li+1];
                setNozzle(ld.dir===1?ld.x+ld.w:ld.x, lerp(ld.y,nxt?nxt.y:ld.y-8,zt), false);
            }
        } else if(e<pp+PAUSE_MS){
            svg.style.opacity='1';
            for(var k=0;k<LAYERS.length;k++) setLayer(k,1);
            var last=LAYERS[LAYERS.length-1];
            setNozzle(last.dir===1?last.x+last.w:last.x, last.y-35, false);
        } else {
            var ft=(e-pp-PAUSE_MS)/FADE_MS;
            svg.style.opacity=String(1-clamp(ft,0,1));
            if(ft>=1){ for(var m=0;m<LAYERS.length;m++) setLayer(m,0); setNozzle(LAYERS[0].x,LAYERS[0].y,false); svg.style.opacity='0'; }
        }
        requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
})();

/* ── Form ────────────────────────────────────────── */
(function(){
    var pw=document.getElementById('Password'),btn=document.getElementById('pwToggle'),
        op=document.getElementById('eyeOpen'),cl=document.getElementById('eyeClosed');
    if(btn&&pw) btn.addEventListener('click',function(){
        var s=pw.type==='text'; pw.type=s?'password':'text';
        op.style.display=s?'':'none'; cl.style.display=s?'none':'';
        btn.setAttribute('aria-pressed',String(!s));
        btn.setAttribute('aria-label',s?'إظهار كلمة المرور':'إخفاء كلمة المرور');
    });
    var f=document.getElementById('loginForm'),sb=document.getElementById('submitBtn');
    if(f&&sb) f.addEventListener('submit',function(){ sb.classList.add('btn-loading'); });
})();
</script>
